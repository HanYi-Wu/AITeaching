# 源远教学平台 / OriginReach：按需取消注释，另存为 educationhelper.env。
# Linux 保留现有 /etc/educationhelper/educationhelper.env，升级不可覆盖。
# 空值不要填写；进程环境变量优先。实际密钥只保存在私有配置中。
# EH_DATA_ROOT=/var/lib/educationhelper
# SOLAIRE_PROJECT_ROOT=/opt/educationhelper
# SOLAIRE_BIND_PROJECT_FROM_ENV=1
# SOLAIRE_PUBLIC_MODE=1
# SOLAIRE_ALLOWED_ORIGINS=https://or.whenry.cc.cd,https://awa.nat100.top
# SOLAIRE_LOGIN_RATE_LIMIT=10
# SOLAIRE_LOGIN_RATE_WINDOW_SECONDS=60
# EH_BACKEND_URL=http://127.0.0.1:8000
# EH_PROXY_HOSTS=127.0.0.1,localhost
# EH_EXTERNAL_PROXY_URL=
# SOLAIRE_LLM_PROVIDER=
# SOLAIRE_LLM_BASE_URL=
# SOLAIRE_LLM_MODEL=
# SOLAIRE_LLM_FAST_MODEL=
# SOLAIRE_LLM_MAX_TOKENS=
# SOLAIRE_LLM_TEMPERATURE=
# SOLAIRE_LLM_REASONING_EFFORT=
# SOLAIRE_LLM_API_KEY=
